@model IEnumerable<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Events";

    var events = Model?.ToList() ?? new List<EventManagementSystem.Models.Event>();
}

<div class="container-fluid py-4 px-3 px-md-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-2">
                Event Management System
            </div>
            <h1 class="fw-bold mb-1">Events</h1>
            <p class="text-secondary mb-0">
                Manage your events, schedules, and ticket prices.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4 py-3 rounded-3 fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>
            Create New Event
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-calendar-event fs-3"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Total Events</div>
                        <div class="fs-3 fw-bold">@events.Count</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-calendar-check fs-3"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Upcoming Events</div>
                        <div class="fs-3 fw-bold">
                            @events.Count(e => e.EventDate.Date >= DateTime.Today)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-ticket-perforated fs-3"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Average Ticket Price</div>
                        <div class="fs-3 fw-bold">
                            @(events.Count > 0
                                                        ? events.Average(e => e.TicketPrice).ToString("N2")
                                                        : "0.00")
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="fw-bold mb-1">All Events</h5>
                    <p class="text-secondary small mb-0">
                        View and manage your event information.
                    </p>
                </div>

                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="eventSearch"
                           class="form-control bg-light border-start-0"
                           placeholder="Search events..."
                           aria-label="Search events" />
                </div>
            </div>
        </div>

        <div class="card-body p-0">

            @if (events.Any())
            {
                <div class="row g-0 bg-light border-top border-bottom py-3 px-4 d-none d-lg-flex text-secondary small fw-semibold">
                    <div class="col-lg-4">EVENT</div>
                    <div class="col-lg-3">DATE & TIME</div>
                    <div class="col-lg-2">TICKET PRICE</div>
                    <div class="col-lg-3 text-end">ACTIONS</div>
                </div>

                <div id="eventList">
                    @foreach (var item in events)
                    {
                        <div class="event-item border-bottom p-3 p-md-4"
                             data-search="@item.EventName?.ToLowerInvariant()">

                            <div class="row align-items-center g-3">

                                <div class="col-12 col-lg-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="event-icon rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0">
                                            <i class="bi bi-calendar2-event fs-4"></i>
                                        </div>

                                        <div>
                                            <div class="fw-bold fs-6 event-name">
                                                @item.EventName
                                            </div>
                                            <div class="text-secondary small">
                                                Event ID: #@item.EventId
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6 col-lg-3">
                                    <div class="text-secondary small d-lg-none mb-1">
                                        Date & Time
                                    </div>
                                    <div class="fw-semibold">
                                        <i class="bi bi-calendar3 text-primary me-2"></i>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="text-secondary small ms-lg-4">
                                        @item.EventDate.ToString("hh:mm tt")
                                    </div>
                                </div>

                                <div class="col-6 col-lg-2">
                                    <div class="text-secondary small d-lg-none mb-1">
                                        Ticket Price
                                    </div>
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2 fs-6">
                                        @item.TicketPrice.ToString("N2")
                                    </span>
                                </div>

                                <div class="col-12 col-lg-3">
                                    <div class="d-flex justify-content-lg-end flex-wrap gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.EventId"
                                           class="btn btn-sm btn-outline-info rounded-3"
                                           title="View Details">
                                            <i class="bi bi-eye me-1"></i>
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.EventId"
                                           class="btn btn-sm btn-outline-primary rounded-3"
                                           title="Edit Event">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.EventId"
                                           class="btn btn-sm btn-outline-danger rounded-3"
                                           title="Delete Event">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </a>

                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>

                <div id="noSearchResults" class="text-center py-5 d-none">
                    <i class="bi bi-search fs-1 text-secondary"></i>
                    <h6 class="fw-bold mt-3">No Events Found</h6>
                    <p class="text-secondary mb-0">
                        Try searching with a different event name.
                    </p>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <div class="mb-3">
                        <i class="bi bi-calendar-x display-3 text-secondary"></i>
                    </div>
                    <h5 class="fw-bold">No Events Yet</h5>
                    <p class="text-secondary">
                        Start by creating your first event.
                    </p>
                    <a asp-action="Create" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-plus-lg me-2"></i>
                        Create Event
                    </a>
                </div>
            }

        </div>

        @if (events.Any())
        {
            <div class="card-footer bg-white border-0 p-3 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small" id="eventCount">
                        Showing @events.Count events
                    </span>
                    <a asp-action="Create"
                       class="text-decoration-none fw-semibold small">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Event
                    </a>
                </div>
            </div>
        }

    </div>

</div>

<style>
    .event-icon {
        width: 54px;
        height: 54px;
    }

    .event-item {
        transition: background-color 0.2s ease;
    }

        .event-item:hover {
            background-color: #f8faff;
        }

    #eventSearch:focus {
        box-shadow: none;
        border-color: #86b7fe;
    }

    @@media (max-width: 767.98px) {
        .event-icon {
            width: 46px;
            height: 46px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("eventSearch");
        const eventItems = document.querySelectorAll(".event-item");
        const noResults = document.getElementById("noSearchResults");
        const eventCount = document.getElementById("eventCount");

        if (!searchInput) return;

        searchInput.addEventListener("input", function () {
            const searchValue = this.value.trim().toLowerCase();
            let visibleCount = 0;

            eventItems.forEach(function (item) {
                const eventName = item.dataset.search || "";
                const isVisible = eventName.includes(searchValue);

                item.classList.toggle("d-none", !isVisible);

                if (isVisible) {
                    visibleCount++;
                }
            });

            if (noResults) {
                noResults.classList.toggle("d-none", visibleCount !== 0);
            }

            if (eventCount) {
                eventCount.textContent =
                    "Showing " + visibleCount + " of " +
                    eventItems.length + " events";
            }
        });
    });
</script>