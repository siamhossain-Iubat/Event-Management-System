@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard {
        --purple: #6c4cf1;
        --ink: #20243a;
        --muted: #858ba3;
        --line: #eceef5;
    }

    .welcome-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

        .welcome-section h1 {
            font-size: clamp(27px, 4vw, 36px);
            font-weight: 800;
            letter-spacing: -1.4px;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .welcome-section p {
            color: var(--muted);
            margin: 0;
            font-size: 14px;
        }

    .primary-btn {
        background: linear-gradient(135deg, #8065ff, #5c3bdf);
        border: none;
        color: white;
        border-radius: 13px;
        padding: 13px 20px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        box-shadow: 0 8px 20px #6c4cf12b;
        transition: .2s;
    }

        .primary-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 24px #6c4cf140;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 23px 20px;
        min-width: 0;
        box-shadow: 0 5px 20px #20243a05;
        transition: .25s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px #20243a0d;
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 21px;
    }

    .purple-icon {
        color: #6c4cf1;
        background: #f0edff;
    }

    .green-icon {
        color: #0a9f79;
        background: #e5f8f1;
    }

    .blue-icon {
        color: #2488e8;
        background: #e9f4ff;
    }

    .orange-icon {
        color: #ef8b2c;
        background: #fff2e5;
    }

    .pink-icon {
        color: #e052a0;
        background: #fff0f7;
    }

    .stat-label {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .stat-value {
        font-size: clamp(22px, 2vw, 29px);
        font-weight: 800;
        letter-spacing: -1px;
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .content-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 5px 20px #20243a05;
        overflow: hidden;
        margin-bottom: 28px;
    }

    .content-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 24px 26px;
        border-bottom: 1px solid var(--line);
    }

        .content-card-header h4 {
            font-size: 18px;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 6px;
        }

        .content-card-header p {
            font-size: 13px;
            color: var(--muted);
            margin: 0;
        }

    .filter-select {
        min-width: 220px;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 12px 38px 12px 15px;
        background-color: #fafaff;
        color: #555b73;
        font-size: 13px;
        font-weight: 600;
        outline: none;
        cursor: pointer;
    }

        .filter-select:focus {
            border-color: #a99aff;
            box-shadow: 0 0 0 3px #6c4cf11a;
        }

    .table-responsive {
        padding: 0 14px 12px;
    }

    .events-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .events-table thead th {
            background: #fafaff;
            color: #858ba3;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: .8px;
            font-weight: 800;
            padding: 17px 15px;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .events-table tbody tr.event-row {
            cursor: pointer;
            transition: .2s;
        }

            .events-table tbody tr.event-row:hover {
                background: #faf9ff;
            }

        .events-table tbody td {
            padding: 19px 15px;
            border-bottom: 1px solid #f0f1f6;
            font-size: 13px;
            color: #565d76;
            vertical-align: middle;
        }

    .event-name {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        color: var(--ink);
    }

    .event-avatar {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #f0edff, #e4ddff);
        color: #6c4cf1;
        font-size: 18px;
        flex-shrink: 0;
    }

    .price-pill {
        background: #f0edff;
        color: #6c4cf1;
        border-radius: 9px;
        padding: 7px 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .attendee-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 600;
    }

    .revenue-value {
        color: #079873;
        font-weight: 800;
        white-space: nowrap;
    }

    .details-hint {
        color: #a2a7ba;
        font-size: 11px;
        margin-left: 5px;
    }

    .summary-row td {
        padding: 0 !important;
        background: #faf9ff;
    }

    .summary-content {
        margin: 16px;
        padding: 20px;
        background: white;
        border: 1px solid #e9e5ff;
        border-radius: 16px;
    }

        .summary-content:empty {
            display: none;
        }

    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: #6c4cf1;
        font-size: 32px;
        border-radius: 24px;
        margin: 0 auto 20px;
    }

    .empty-state h5 {
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--muted);
        font-size: 14px;
        margin-bottom: 22px;
    }

    .summary-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 20px 26px;
        background: #fafaff;
        border-top: 1px solid var(--line);
    }

        .summary-footer span {
            color: var(--muted);
            font-size: 12px;
        }

        .summary-footer strong {
            color: var(--ink);
        }

    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .stat-card {
            padding: 17px 15px;
        }

        .stat-top {
            margin-bottom: 15px;
        }

        .content-card-header {
            padding: 20px;
        }

        .filter-select {
            width: 100%;
        }

        .events-table {
            min-width: 650px;
        }

        .summary-footer {
            padding: 18px 20px;
        }
    }

    @@media (max-width: 420px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard">
    <section class="welcome-section">
        <div>
            <h1>Welcome back! 👋</h1>
            <p>Here's what's happening with your events today.</p>
        </div>

        <a asp-controller="Events" asp-action="Create" class="primary-btn">
            <i class="bi bi-plus-lg"></i>
            Create New Event
        </a>
    </section>

    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon purple-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <i class="bi bi-three-dots" style="color:#a0a5b7"></i>
            </div>
            <div class="stat-label">Total Events</div>
            <div class="stat-value">@ViewBag.TotalEvents</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon green-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <i class="bi bi-three-dots" style="color:#a0a5b7"></i>
            </div>
            <div class="stat-label">Total Revenue</div>
            <div class="stat-value">৳@(((decimal)(ViewBag.GrandTotalRevenue ?? 0)).ToString("N0"))</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon blue-icon">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <i class="bi bi-three-dots" style="color:#a0a5b7"></i>
            </div>
            <div class="stat-label">Average Ticket Price</div>
            <div class="stat-value">৳@(((decimal)(ViewBag.AvgTicketPrice ?? 0)).ToString("N0"))</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon orange-icon">
                    <i class="bi bi-arrow-up-circle"></i>
                </div>
                <i class="bi bi-three-dots" style="color:#a0a5b7"></i>
            </div>
            <div class="stat-label">Maximum Ticket Price</div>
            <div class="stat-value">৳@(((decimal)(ViewBag.MaxPrice ?? 0)).ToString("N0"))</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon pink-icon">
                    <i class="bi bi-arrow-down-circle"></i>
                </div>
                <i class="bi bi-three-dots" style="color:#a0a5b7"></i>
            </div>
            <div class="stat-label">Minimum Ticket Price</div>
            <div class="stat-value">৳@(((decimal)(ViewBag.MinPrice ?? 0)).ToString("N0"))</div>
        </div>
    </section>

    <section class="content-card">
        <div class="content-card-header">
            <div>
                <h4>Event Management</h4>
                <p>View and manage your events and revenue.</p>
            </div>

            <form method="get" id="aggregateForm">
                <select name="aggregateType" class="filter-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentFilter as string))">
                        All Events
                    </option>
                    <option value="Max" selected="@(ViewBag.CurrentFilter as string == "Max")">
                        Maximum Price Events
                    </option>
                    <option value="Min" selected="@(ViewBag.CurrentFilter as string == "Min")">
                        Minimum Price Events
                    </option>
                    <option value="Avg" selected="@(ViewBag.CurrentFilter as string == "Avg")">
                        Above Average Price
                    </option>
                </select>
            </form>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="events-table">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Ticket Price</th>
                            <th>Attendees</th>
                            <th>Total Revenue</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="event-row" onclick="loadSummary(@item.EventId)">
                                <td>
                                    <div class="event-name">
                                        <div class="event-avatar">
                                            <i class="bi bi-calendar2-event"></i>
                                        </div>
                                        <span>@item.EventName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="price-pill">৳@item.TicketPrice.ToString("N2")</span>
                                </td>
                                <td>
                                    <span class="attendee-count">
                                        <i class="bi bi-people" style="color:#6c4cf1"></i>
                                        @item.TotalAttendees
                                    </span>
                                </td>
                                <td>
                                    <span class="revenue-value">৳@item.TotalRevenue.ToString("N2")</span>
                                </td>
                                <td>
                                    <span style="color:#6c4cf1;font-weight:700;font-size:12px">
                                        View <i class="bi bi-chevron-down"></i>
                                    </span>
                                </td>
                            </tr>

                            <tr id="summary-row-@item.EventId" class="summary-row" style="display:none">
                                <td colspan="5">
                                    <div id="summary-content-@item.EventId" class="summary-content"></div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-calendar2-plus"></i>
                </div>
                <h5>No events found</h5>
                <p>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter as string))
                    {
                        <span>No events match this filter. Try selecting All Events.</span>
                    }
                    else
                    {
                        <span>Your event list is empty. Create your first event to get started.</span>
                    }
                </p>
                <a asp-controller="Events" asp-action="Create" class="primary-btn">
                    <i class="bi bi-plus-lg"></i>
                    Create Your First Event
                </a>
            </div>
        }

        <div class="summary-footer">
            <span>
                Showing <strong>@(Model?.Count ?? 0)</strong> event(s)
            </span>
            <span>
                <i class="bi bi-shield-check me-1" style="color:#0a9f79"></i>
                Event data overview
            </span>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function loadSummary(id) {
            var summaryRow = $("#summary-row-" + id);
            var summaryContent = $("#summary-content-" + id);

            if (summaryRow.is(":visible")) {
                summaryRow.stop(true, true).slideUp(200);
                return;
            }

            $(".summary-row").stop(true, true).hide();

            summaryContent.html(
                '<div class="text-center py-3">' +
                '<div class="spinner-border" style="color:#6c4cf1" role="status"></div>' +
                '<p class="mt-2 mb-0 text-muted small">Loading event details...</p>' +
                '</div>'
            );

            summaryRow.stop(true, true).slideDown(200);

            $.get("/Home/GetEventSummary", { eventId: id })
                .done(function (data) {
                    summaryContent.html(data);
                })
                .fail(function () {
                    summaryContent.html(
                        '<div class="alert alert-danger mb-0">' +
                        'Unable to load event details. Please try again.' +
                        '</div>'
                    );
                });
        }
    </script>
}